# ===== 禁用所有会把 host 端 rust 编译器拉进来的包 =====
# 直接原因：compile_base.config 强制 CONFIG_PACKAGE_easytier=y（EasyTier 是 Rust 编写）
# host rust 编译需从 rust-lang CI 下载 LLVM 预编译包，该地址当前 404，必然失败
# CONFIG_PACKAGE_easytier is not set
# CONFIG_PACKAGE_luci-app-easytier is not set
# CONFIG_PACKAGE_luci-app-vantage is not set
# CONFIG_PACKAGE_rust is not set
# CONFIG_PACKAGE_rust-bindgen is not set
# CONFIG_PACKAGE_rustdesk-server is not set
# CONFIG_PACKAGE_luci-app-rustdesk-server is not set
# CONFIG_PACKAGE_librespeed-cli-rust is not set
# CONFIG_PACKAGE_shadowsocks-rust is not set
# CONFIG_PACKAGE_python3-setuptools-rust is not set
# CONFIG_PACKAGE_python3-maturin is not set
# CONFIG_PACKAGE_python3-cryptography is not set
# CONFIG_PACKAGE_python3-cryptography-src is not set
# CONFIG_PACKAGE_python3-paramiko is not set
# CONFIG_PACKAGE_python3-pyopenssl is not set
# CONFIG_PACKAGE_python3-twisted is not set
# CONFIG_PACKAGE_python3-service-identity is not set
# CONFIG_PACKAGE_python3-pymysql is not set
