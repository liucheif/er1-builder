# ===== 禁用 Rust 工具链（宿主编译需从 rust-lang CI 下载 LLVM，当前 404 导致构建失败）=====
# CONFIG_PACKAGE_rust is not set
CONFIG_PACKAGE_rust-bindgen=n
CONFIG_PACKAGE_rustdesk-server=n
CONFIG_PACKAGE_luci-app-rustdesk-server=n
CONFIG_PACKAGE_librespeed-cli-rust=n
CONFIG_PACKAGE_shadowsocks-rust=n
CONFIG_PACKAGE_python3-setuptools-rust=n
CONFIG_PACKAGE_python3-maturin=n
CONFIG_PACKAGE_python3-cryptography=n
CONFIG_PACKAGE_python3-cryptography-src=n
CONFIG_PACKAGE_python3-paramiko=n
CONFIG_PACKAGE_python3-pyopenssl=n
CONFIG_PACKAGE_python3-twisted=n
CONFIG_PACKAGE_python3-service-identity=n
CONFIG_PACKAGE_python3-pymysql=n
